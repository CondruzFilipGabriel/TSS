digraph example1_cause_effect {
  graph [rankdir=LR, bgcolor="#FFFFFF", fontname="DejaVu Sans", fontcolor="#263238", label="Graf cauza-efect - examples/1/to_test.py", labelloc=t, fontsize=18, margin=0.25, pad=0.2, color="#D5DBE5"];
  node [style="rounded,filled", fillcolor="#F8FAFC", color="#546E7A", penwidth=1.4, fontname="DejaVu Sans", fontcolor="#263238", fontsize=11];
  edge [fontname="DejaVu Sans", fontcolor="#263238", fontsize=10, color="#607D8B", penwidth=1.3, arrowsize=0.8];

  subgraph cluster_causes {
    label="Cauze";
    fontcolor="#1D4ED8";
    color="#93C5FD";
    style="rounded,filled";
    fillcolor="#EFF6FF";
    C1 [shape=box, fillcolor="#DBEAFE", color="#2563EB", label="C1\nweight_kg < 0"];
    C2 [shape=box, fillcolor="#DBEAFE", color="#2563EB", label="C2\ndistance_km < 0"];
    C3 [shape=box, fillcolor="#DCFCE7", color="#16A34A", label="C3\nweight_kg <= 5"];
    C4 [shape=box, fillcolor="#FCE7F3", color="#DB2777", label="C4\nfragile == True"];
    C5 [shape=box, fillcolor="#FEF3C7", color="#D97706", label="C5\ndistance_km > 100"];
    C6 [shape=box, fillcolor="#CCFBF1", color="#0F766E", label="C6\ncheckpoints > 3\n(distance_km > 150)"];
  }

  subgraph cluster_logic {
    label="Logica";
    fontcolor="#7C2D12";
    color="#FDBA74";
    style="rounded,filled";
    fillcolor="#FFF7ED";
    OR_invalid [shape=circle, fillcolor="#FFEDD5", color="#EA580C", label="OR"];
    VALID [shape=circle, fillcolor="#E0F2FE", color="#0284C7", label="valid"];
    NOTC3 [shape=circle, fillcolor="#EDE9FE", color="#7C3AED", label="not C3"];
    AND_special [shape=circle, fillcolor="#FFE4E6", color="#E11D48", label="AND"];
  }

  subgraph cluster_effects {
    label="Efecte";
    fontcolor="#166534";
    color="#86EFAC";
    style="rounded,filled";
    fillcolor="#F0FDF4";
    E1 [shape=box, fillcolor="#FFE0E0", color="#C62828", label="E1\nValueError"];
    E2 [shape=box, fillcolor="#D1FAE5", color="#059669", label="E2\nstatus = light"];
    E3 [shape=box, fillcolor="#EDE9FE", color="#7C3AED", label="E3\nstatus = heavy"];
    E4 [shape=box, fillcolor="#FCE7F3", color="#DB2777", label="E4\nstatus = special_handling"];
    E5 [shape=box, fillcolor="#CFFAFE", color="#0891B2", label="E5\nadauga _long_route"];
  }

  C1 -> OR_invalid [color="#2563EB"];
  C2 -> OR_invalid [color="#2563EB"];
  OR_invalid -> E1 [color="#C62828"];
  OR_invalid -> VALID [label="False", color="#0284C7"];

  VALID -> E2 [color="#059669"];
  C3 -> E2 [label="True", color="#16A34A"];
  C3 -> NOTC3 [label="False", color="#7C3AED"];
  NOTC3 -> E3 [color="#7C3AED"];

  VALID -> AND_special [color="#0284C7"];
  C4 -> AND_special [color="#DB2777"];
  C5 -> AND_special [color="#D97706"];
  AND_special -> E4 [label="True\nmascheaza E2/E3", color="#DB2777"];

  C6 -> E5 [label="True", color="#0F766E"];
  E2 -> E5 [style=dashed, color="#059669", label="poate fi modificat"];
  E3 -> E5 [style=dashed, color="#7C3AED", label="poate fi modificat"];
  E4 -> E5 [style=dashed, color="#DB2777", label="poate fi modificat"];
}
