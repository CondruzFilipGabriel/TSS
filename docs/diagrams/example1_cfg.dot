digraph example1_cfg {
  graph [rankdir=TB, bgcolor="#FFFFFF", fontname="DejaVu Sans", fontcolor="#263238", label="CFG - examples/1/to_test.py", labelloc=t, fontsize=18, margin=0.25, pad=0.2, color="#D5DBE5"];
  node [shape=box, style="rounded,filled", fillcolor="#F8FAFC", color="#546E7A", penwidth=1.4, fontname="DejaVu Sans", fontcolor="#263238", fontsize=11];
  edge [fontname="DejaVu Sans", fontcolor="#263238", fontsize=10, color="#607D8B", penwidth=1.3, arrowsize=0.8];

  start [shape=oval, fillcolor="#DDEBFF", color="#3367D6", label="Start\nclassify_delivery(weight_kg, distance_km, fragile)"];
  validate [shape=diamond, fillcolor="#FFF2CC", color="#D97706", label="weight_kg < 0\nor distance_km < 0?"];
  error [shape=box, fillcolor="#FFE0E0", color="#C62828", label="raise ValueError"];
  init [fillcolor="#E8F5E9", color="#2E7D32", label="checkpoints = 0"];
  loop [shape=diamond, fillcolor="#E0F2FE", color="#0284C7", label="mai exista segment\nin range(0, distance_km, 50)?"];
  inc [fillcolor="#DCFCE7", color="#16A34A", label="checkpoints += 1"];
  weight [shape=diamond, fillcolor="#FDE68A", color="#CA8A04", label="weight_kg <= 5?"];
  light [fillcolor="#D1FAE5", color="#059669", label="status = light"];
  heavy [fillcolor="#EDE9FE", color="#7C3AED", label="status = heavy"];
  fragile [shape=diamond, fillcolor="#FFE4E6", color="#E11D48", label="fragile and\ndistance_km > 100?"];
  special [fillcolor="#FCE7F3", color="#DB2777", label="status = special_handling\n(suprascrie light/heavy)"];
  longroute [shape=diamond, fillcolor="#CCFBF1", color="#0F766E", label="checkpoints > 3?"];
  suffix [fillcolor="#CFFAFE", color="#0891B2", label="status = status +\n_long_route"];
  ret [shape=oval, fillcolor="#DCFCE7", color="#16A34A", label="return status"];

  start -> validate [color="#3367D6"];
  validate -> error [label="True", color="#C62828"];
  validate -> init [label="False", color="#2E7D32"];
  init -> loop [color="#0284C7"];
  loop -> inc [label="True", color="#0284C7"];
  inc -> loop [color="#0284C7"];
  loop -> weight [label="False", color="#CA8A04"];
  weight -> light [label="True", color="#059669"];
  weight -> heavy [label="False", color="#7C3AED"];
  light -> fragile [color="#E11D48"];
  heavy -> fragile [color="#E11D48"];
  fragile -> special [label="True", color="#DB2777"];
  fragile -> longroute [label="False", color="#0F766E"];
  special -> longroute [color="#0F766E"];
  longroute -> suffix [label="True", color="#0891B2"];
  longroute -> ret [label="False", color="#16A34A"];
  suffix -> ret [color="#16A34A"];
}
