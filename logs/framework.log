2026-05-14 01:19:47 [AutoTesting]             status = "light"
2026-05-14 01:19:47 [AutoTesting]         else:
2026-05-14 01:19:47 [AutoTesting]             status = "heavy"
2026-05-14 01:19:47 [AutoTesting]     
2026-05-14 01:19:47 [AutoTesting]         # Fragile long-distance deliveries require a special status.
2026-05-14 01:19:47 [AutoTesting]         # This branch uses a compound condition and intentionally has no else block.
