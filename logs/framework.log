2026-05-14 00:22:47 [AutoTesting]             status = "light"
2026-05-14 00:22:47 [AutoTesting]         else:
2026-05-14 00:22:47 [AutoTesting]             status = "heavy"
2026-05-14 00:22:47 [AutoTesting]     
2026-05-14 00:22:47 [AutoTesting]         # Fragile long-distance deliveries require a special status.
2026-05-14 00:22:47 [AutoTesting]         # This branch uses a compound condition and intentionally has no else block.
2026-05-14 00:22:47 [AutoTesting]         if fragile and distance_km > 100:
2026-05-14 00:22:47 [AutoTesting]             status = "special_handling"
2026-05-14 00:22:47 [AutoTesting]     
2026-05-14 00:22:47 [AutoTesting]         # Long routes keep the previous classification, but add extra context.
2026-05-14 00:22:47 [AutoTesting]         # This is a simple condition without an else branch.
