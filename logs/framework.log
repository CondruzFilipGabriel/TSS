2026-05-14 00:20:53 [AutoTesting]         # numeric parameter must stop the function immediately.
2026-05-14 00:20:53 [AutoTesting]         if weight_kg < 0 or distance_km < 0:
2026-05-14 00:20:53 [AutoTesting]             raise ValueError("Parametrii numerici nu pot fi negativi.")
2026-05-14 00:20:53 [AutoTesting]     
2026-05-14 00:20:53 [AutoTesting]         # Count route checkpoints manually in order to create a simple repetitive path.
2026-05-14 00:20:53 [AutoTesting]         # The loop is useful for tests because mutations may change the step, the range,
2026-05-14 00:20:53 [AutoTesting]         # or the final checkpoint count.
2026-05-14 00:20:53 [AutoTesting]         checkpoints = 0
