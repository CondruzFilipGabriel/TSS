2026-05-14 00:36:21 [AutoTesting]     # This function classifies a delivery request and returns a status string.
2026-05-14 00:36:21 [AutoTesting]     # It first validates that the numeric inputs are non-negative.
2026-05-14 00:36:21 [AutoTesting]     # Then it counts route checkpoints through a loop, using one checkpoint for
2026-05-14 00:36:21 [AutoTesting]     # every started 50 km segment of the delivery route.
2026-05-14 00:36:21 [AutoTesting]     # After validation and route analysis, it classifies the delivery:
2026-05-14 00:36:21 [AutoTesting]     # - light deliveries have weight up to 5 kg;
2026-05-14 00:36:21 [AutoTesting]     # - heavier deliveries are classified as heavy;
2026-05-14 00:36:21 [AutoTesting]     # - fragile deliveries over long distances require special handling;
2026-05-14 00:36:21 [AutoTesting]     # - routes with many checkpoints receive a long-route suffix.
2026-05-14 00:36:21 [AutoTesting]     
2026-05-14 00:36:21 [AutoTesting]     def classify_delivery(weight_kg: int, distance_km: int, fragile: bool) -> str:
2026-05-14 00:36:21 [AutoTesting]         """
2026-05-14 00:36:21 [AutoTesting]         Returns a simple classification for a delivery request.
2026-05-14 00:36:21 [AutoTesting]     
2026-05-14 00:36:21 [AutoTesting]         Rules:
2026-05-14 00:36:21 [AutoTesting]         - weight_kg must be >= 0
2026-05-14 00:36:21 [AutoTesting]         - distance_km must be >= 0
2026-05-14 00:36:21 [AutoTesting]         - fragile indicates whether the package needs extra care
2026-05-14 00:36:21 [AutoTesting]         - distance is analyzed through a small loop that counts 50 km checkpoints
2026-05-14 00:36:21 [AutoTesting]         """
2026-05-14 00:36:21 [AutoTesting]     
2026-05-14 00:36:21 [AutoTesting]         # Validate the basic input domain.
2026-05-14 00:36:21 [AutoTesting]         # This compound condition is an important test target because any negative
2026-05-14 00:36:21 [AutoTesting]         # numeric parameter must stop the function immediately.
2026-05-14 00:36:21 [AutoTesting]         if weight_kg < 0 or distance_km < 0:
2026-05-14 00:36:21 [AutoTesting]             raise ValueError("Parametrii numerici nu pot fi negativi.")
2026-05-14 00:36:21 [AutoTesting]     
2026-05-14 00:36:21 [AutoTesting]         # Count route checkpoints manually in order to create a simple repetitive path.
2026-05-14 00:36:21 [AutoTesting]         # The loop is useful for tests because mutations may change the step, the range,
2026-05-14 00:36:21 [AutoTesting]         # or the final checkpoint count.
2026-05-14 00:36:21 [AutoTesting]         checkpoints = 0
2026-05-14 00:36:21 [AutoTesting]         for _ in range(0, distance_km, 50):
2026-05-14 00:36:21 [AutoTesting]             checkpoints += 1
2026-05-14 00:36:21 [AutoTesting]     
2026-05-14 00:36:21 [AutoTesting]         # Apply the main weight classification.
2026-05-14 00:36:21 [AutoTesting]         # This if/else is a key branch because it separates normal light packages
