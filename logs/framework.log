2026-05-14 00:21:26 [AutoTesting]         # or the final checkpoint count.
2026-05-14 00:21:26 [AutoTesting]         checkpoints = 0
2026-05-14 00:21:26 [AutoTesting]         for _ in range(0, distance_km, 50):
2026-05-14 00:21:26 [AutoTesting]             checkpoints += 1
2026-05-14 00:21:26 [AutoTesting]     
2026-05-14 00:21:26 [AutoTesting]         # Apply the main weight classification.
