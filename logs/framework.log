2026-05-14 00:59:58 [AutoTesting]         if weight_kg <= 5:
2026-05-14 00:59:58 [AutoTesting]             status = "light"
2026-05-14 00:59:58 [AutoTesting]         else:
2026-05-14 00:59:58 [AutoTesting]             status = "heavy"
2026-05-14 00:59:58 [AutoTesting]     
2026-05-14 00:59:58 [AutoTesting]         # Fragile long-distance deliveries require a special status.
2026-05-14 00:59:58 [AutoTesting]         # This branch uses a compound condition and intentionally has no else block.
2026-05-14 00:59:58 [AutoTesting]         if fragile and distance_km > 100:
