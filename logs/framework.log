2026-05-14 00:29:20 [AutoTesting]     # - heavier deliveries are classified as heavy;
2026-05-14 00:29:20 [AutoTesting]     # - fragile deliveries over long distances require special handling;
2026-05-14 00:29:20 [AutoTesting]     # - routes with many checkpoints receive a long-route suffix.
2026-05-14 00:29:20 [AutoTesting]     
2026-05-14 00:29:20 [AutoTesting]     def classify_delivery(weight_kg: int, distance_km: int, fragile: bool) -> str:
2026-05-14 00:29:20 [AutoTesting]         """
2026-05-14 00:29:20 [AutoTesting]         Returns a simple classification for a delivery request.
2026-05-14 00:29:20 [AutoTesting]     
2026-05-14 00:29:20 [AutoTesting]         Rules:
2026-05-14 00:29:20 [AutoTesting]         - weight_kg must be >= 0
2026-05-14 00:29:20 [AutoTesting]         - distance_km must be >= 0
2026-05-14 00:29:20 [AutoTesting]         - fragile indicates whether the package needs extra care
2026-05-14 00:29:20 [AutoTesting]         - distance is analyzed through a small loop that counts 50 km checkpoints
2026-05-14 00:29:20 [AutoTesting]         """
2026-05-14 00:29:20 [AutoTesting]     
2026-05-14 00:29:20 [AutoTesting]         # Validate the basic input domain.
2026-05-14 00:29:20 [AutoTesting]         # This compound condition is an important test target because any negative
2026-05-14 00:29:20 [AutoTesting]         # numeric parameter must stop the function immediately.
2026-05-14 00:29:20 [AutoTesting]         if weight_kg < 0 or distance_km < 0:
2026-05-14 00:29:20 [AutoTesting]             raise ValueError("Parametrii numerici nu pot fi negativi.")
2026-05-14 00:29:20 [AutoTesting]     
2026-05-14 00:29:20 [AutoTesting]         # Count route checkpoints manually in order to create a simple repetitive path.
2026-05-14 00:29:20 [AutoTesting]         # The loop is useful for tests because mutations may change the step, the range,
2026-05-14 00:29:20 [AutoTesting]         # or the final checkpoint count.
2026-05-14 00:29:20 [AutoTesting]         checkpoints = 0
2026-05-14 00:29:20 [AutoTesting]         for _ in range(0, distance_km, 50):
2026-05-14 00:29:20 [AutoTesting]             checkpoints += 1
2026-05-14 00:29:20 [AutoTesting]     
2026-05-14 00:29:20 [AutoTesting]         # Apply the main weight classification.
2026-05-14 00:29:20 [AutoTesting]         # This if/else is a key branch because it separates normal light packages
2026-05-14 00:29:20 [AutoTesting]         # from heavier packages.
2026-05-14 00:29:20 [AutoTesting]         if weight_kg <= 5:
2026-05-14 00:29:20 [AutoTesting]             status = "light"
2026-05-14 00:29:20 [AutoTesting]         else:
2026-05-14 00:29:20 [AutoTesting]             status = "heavy"
2026-05-14 00:29:20 [AutoTesting]     
2026-05-14 00:29:20 [AutoTesting]         # Fragile long-distance deliveries require a special status.
2026-05-14 00:29:20 [AutoTesting]         # This branch uses a compound condition and intentionally has no else block.
2026-05-14 00:29:20 [AutoTesting]         if fragile and distance_km > 100:
2026-05-14 00:29:20 [AutoTesting]             status = "special_handling"
2026-05-14 00:29:20 [AutoTesting]     
2026-05-14 00:29:20 [AutoTesting]         # Long routes keep the previous classification, but add extra context.
2026-05-14 00:29:20 [AutoTesting]         # This is a simple condition without an else branch.
