2026-05-14 00:16:53 [AutoTesting]             status = "light"
2026-05-14 00:16:53 [AutoTesting]         else:
2026-05-14 00:16:53 [AutoTesting]             status = "heavy"
2026-05-14 00:16:53 [AutoTesting]     
2026-05-14 00:16:53 [AutoTesting]         # Fragile long-distance deliveries require a special status.
2026-05-14 00:16:53 [AutoTesting]         # This branch uses a compound condition and intentionally has no else block.
