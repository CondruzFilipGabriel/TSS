2026-05-14 01:27:41 [AutoTesting]         if weight_kg <= 5:
2026-05-14 01:27:41 [AutoTesting]             status = "light"
2026-05-14 01:27:41 [AutoTesting]         else:
2026-05-14 01:27:41 [AutoTesting]             status = "heavy"
2026-05-14 01:27:41 [AutoTesting]     
2026-05-14 01:27:41 [AutoTesting]         # Fragile long-distance deliveries require a special status.
2026-05-14 01:27:41 [AutoTesting]         # This branch uses a compound condition and intentionally has no else block.
2026-05-14 01:27:41 [AutoTesting]         if fragile and distance_km > 100:
