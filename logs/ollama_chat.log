o:\n        return \"ready\"\n\n    if total_skill >= 12:\n        return \"promising\"\n\n    return \"needs_scope_cut\"\n```\n\nPrevious proposed answer to be corrected:\n```python\ndef test_classify_hackathon_team_unbalanced_with_demo():\n    members = [\n        {\"skill\": 5, \"role\": \"backend\", \"available\": True},\n        {\"skill\": 3, \"role\": \"frontend\", \"available\": True}\n    ]\n    hours_left = 10\n    has_demo = True\n\n    result = classify_hackathon_team(members, hours_left, has_demo)\n\n    assert result == \"unbalanced\"\n```\n\nValidation error:\nAssertionError: assert 'needs_scope_cut' == 'unbalanced'", "response": "```python\ndef test_classify_hackathon_team_unbalanced_with_demo():\n    members = [\n        {\"skill\": 5, \"role\": \"backend\", \"available\": True},\n        {\"skill\": 3, \"role\": \"frontend\", \"available\": True}\n    ]\n    hours_left = 10\n    has_demo = True\n\n    result = classify_hackathon_team(members, hours_left, has_demo)\n\n    assert result == \"promising\"\n```", "duration_sec": 34.2223}
